# =============================================================================
# RailOpt AI — Production Environment Variables
# =============================================================================
# Copy this file to .env in production, or configure these variables directly
# in your cloud hosting provider (Render, Railway, AWS ECS, Docker, Kubernetes).
# =============================================================================

# 1. APPLICATION RUNTIME
ENVIRONMENT=production
DEBUG=false
APP_NAME=RailOpt AI
VERSION=2.0.0

# 2. MANAGED POSTGRESQL DATABASE URI
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?sslmode=require
# Examples:
#   Render: Automatically injected via render.yaml (or from Database -> Internal DB URL)
#   AWS RDS / Supabase: postgresql://postgres:YOUR_PASSWORD@db.example.com:5432/railopt?sslmode=require
DATABASE_URL=postgresql://railopt_user:STRONG_DB_PASSWORD@your-postgres-host.com:5432/railopt?sslmode=require

# Database Connection Pool Tuning
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=30

# 3. JWT AUTHENTICATION SECRET KEY
# Generate a cryptographically secure 256-bit key using:
#   Linux/macOS: openssl rand -hex 32
#   Python: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=GENERATE_AND_PASTE_YOUR_MIN_32_CHAR_RANDOM_SECRET_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 4. GOOGLE GEMINI AI LLM API KEY
# Obtain a free or enterprise API key from Google AI Studio:
#   https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_GEMINI_API_KEY

# 5. CROSS-ORIGIN RESOURCE SHARING (CORS)
# Comma-delimited list or JSON array of authorized production frontend URLs
# No trailing slashes.
CORS_ORIGINS=https://railopt-frontend.onrender.com,https://railopt.railways.gov.in

# 6. FRONTEND API TARGET (Used during client Vite build)
# The public HTTPS URL where your FastAPI backend is accessible
VITE_API_URL=https://railopt-api.onrender.com
